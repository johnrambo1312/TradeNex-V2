# Salin fail ini kepada .env dan isi nilai yang sesuai
# cp .env.example .env

# WAJIB: Kunci rahsia Flask (generate dengan: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=tukar-kepada-string-rawak-yang-panjang

# WAJIB (production): URL database PostgreSQL dari Railway
# Biarkan kosong untuk guna SQLite (development sahaja)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Password admin lalai (akan digunakan semasa init-db pertama kali)
# PENTING: Tukar selepas deploy pertama!
DEFAULT_ADMIN_PASSWORD=tukar-password-ini

# Set kepada "1" untuk enable debug mode (JANGAN di production)
FLASK_DEBUG=0

# Port untuk server (Railway akan set ini secara automatik)
PORT=5000
